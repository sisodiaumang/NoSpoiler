{
  "manifest_version": 3,
  "name": "NoSpoiler - Smart Keyword & Content Blur",
  "version": "1.0.0",
  "description": "React-powered extension that blurs posts, videos, images, and text containing your keywords across social media and the web.",
  "icons": {
    "16": "dist/icons/icon16.png",
    "32": "dist/icons/icon32.png",
    "48": "dist/icons/icon48.png",
    "128": "dist/icons/icon128.png"
  },
  "action": {
    "default_popup": "dist/index.html",
    "default_icon": {
      "16": "dist/icons/icon16.png",
      "32": "dist/icons/icon32.png",
      "48": "dist/icons/icon48.png",
      "128": "dist/icons/icon128.png"
    },
    "default_title": "NoSpoiler Settings"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "dist/scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/scripts/content.js"],
      "css": ["dist/scripts/content.css"],
      "run_at": "document_start"
    }
  ]
}
